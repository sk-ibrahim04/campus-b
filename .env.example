# ============================================================
# CAMPUSSYNAPSE ENVIRONMENT CONFIGURATION
# ============================================================

# Database (optional for local dev: falls back to in-memory MongoDB)
MONGODB_URI=mongodb://localhost:27017/campussynapse

# JWT Authentication
JWT_SECRET=super_secret_campussynapse_jwt_key_sih2026

# Server Ports
PORT=5000
NODE_ENV=development

# Optimization Microservice
OPTIMIZER_URL=http://localhost:8000

# Client Application URL
CLIENT_URL=http://localhost:5173

# AI Providers (optional: falls back to deterministic rule-based engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default Autonomy Level (0 = Observe, 1 = Recommend, 2 = Approve then Execute, 3 = Safe Action Auto)
DEFAULT_AUTONOMY_LEVEL=2
